{
  "name": "free-fire-tournament-manager",
  "version": "1.0.0",
  "description": "Free Fire Esports Tournament Management System with Excel Rosters, Fair Spin Wheel, Discord Bot, and Team Rotation",
  "main": "dist-electron/main.cjs",
  "author": "Tournament Admin",
  "license": "MIT",
  "scripts": {
    "dev": "node build-electron.js && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:electron": "node build-electron.js",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "keywords": ["freefire", "esports", "tournament", "discord", "spin-wheel"],
  "type": "commonjs",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "framer-motion": "^14.8.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.2",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
